# ---------------------------------------------------------------------------
# Supabase — project "umucuruziltd"
# ---------------------------------------------------------------------------
# Public: safe to expose to the browser. Every public-facing table has an
# explicit "public read" RLS policy, so the anon key can only ever read what
# an anonymous visitor is allowed to see.
NEXT_PUBLIC_SUPABASE_URL=https://cylimpxmehjofvgrcpbk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_oQ_qicfN0jXyMi6ViO0jEA_lOeOOHgW

# Secret: server-only. NEVER prefix this with NEXT_PUBLIC_, never import it
# into a client component. Used to create/update orders and (later) to run
# the POS sync. Get it from: Supabase dashboard → umucuruziltd project →
# Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# POS integration — intentionally left blank until the POS API is designed.
# Nothing in this codebase calls POS_API_BASE_URL automatically; fill these
# in once that API exists and the sync route (app/api/pos/sync/route.ts)
# starts being used for real. See its file comment for the exact request
# shape and the two supported modes (push vs pull).
# ---------------------------------------------------------------------------

# Base URL of the POS's restaurant/menu API, e.g. https://pos.beep.rw/api
# Only needed for the "pull" mode described in app/api/pos/sync/route.ts.
POS_API_BASE_URL=

# Bearer token used when this app calls the POS API in pull mode.
POS_API_KEY=

# Shared secret the POS must send as the `x-pos-webhook-secret` header when
# calling POST /api/pos/sync. Generate a long random string when you're
# ready to turn this on — until this is set, that route stays disabled
# (returns 503) even if called.
POS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Used for canonical URLs, sitemap.xml, robots.txt and JSON-LD structured
# data. Set this to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
